# ============================================================
# Postgres — используется контейнером db И собирается вручную в
# DATABASE_URL контейнера app (см. docker-compose.yml). При изменении
# USER/PASSWORD/DB обнови их согласованно — друг из друга не выводятся.
# ============================================================
POSTGRES_USER=roadwits
POSTGRES_PASSWORD=roadwits
POSTGRES_DB=roadwits
POSTGRES_PORT=5432

# ============================================================
# Backend
# ============================================================
APP_NAME=Roadwits
GRPC_PORT=50051

JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRE_MINUTES=10080

# ============================================================
# Первая лицензия создается не через сеть (см. README.md), CLI-флаги
# заменяют эти переменные — держим их здесь просто для справки.
# ADMIN_EMAIL=admin@roadwits.local
# ADMIN_LICENSE_DAYS=3650
# ============================================================
