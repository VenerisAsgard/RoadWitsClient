{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadwits",
  "version": "1.1.14",
  "identifier": "com.roadwits.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Roadwits",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "msi", "nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/VenerisAsgard/RoadWitsClient/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyOEE5MTUxQzY2RjgyQjQKUldTMGdtL0dVWkdLa29yQW5ETktDbDRLeUpWVlQ0dTduOTBJTkx5bEpVTjJhVUFFNkVXL3JNQ1QK"
    }
  }
}
