{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadwits",
  "version": "1.2.1",
  "identifier": "com.roadwits.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Roadwits",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
