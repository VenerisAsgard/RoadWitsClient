#!/bin/bash

TAURI_CONFIG="src-tauri/tauri.conf.json"
CARGO_FILE="src-tauri/Cargo.toml"


# Проверяем наличие файлов
if [ ! -f "$TAURI_CONFIG" ]; then
    echo "Ошибка: нет файла $TAURI_CONFIG"
    exit 1
fi

if [ ! -f "$CARGO_FILE" ]; then
    echo "Ошибка: нет файла $CARGO_FILE"
    exit 1
fi


# Получаем текущую версию из tauri.conf.json
old_version=$(grep '"version"' "$TAURI_CONFIG" \
    | head -1 \
    | sed -E 's/.*"version":[[:space:]]*"([^"]+)".*/\1/')


echo "=============================="
echo "Текущая версия: $old_version"
echo "=============================="


# Запрашиваем новую версию
read -p "Новая версия: " new_version


# Проверяем ввод
if [ -z "$new_version" ]; then
    echo "Ошибка: версия не указана"
    exit 1
fi


# Проверяем формат X.Y.Z
if ! [[ "$new_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Ошибка: формат версии должен быть X.Y.Z"
    echo "Пример: 0.1.1"
    exit 1
fi


# Проверяем существует ли такой тег
if git tag | grep -q "^v$new_version$"; then
    echo "Ошибка: тег v$new_version уже существует"
    exit 1
fi


echo ""
echo "Изменение версии:"
echo "$old_version -> $new_version"
echo ""


# Меняем версию Tauri
sed -i -E \
"s/\"version\":[[:space:]]*\"[^\"]+\"/\"version\": \"$new_version\"/" \
"$TAURI_CONFIG"


# Меняем версию Cargo
sed -i -E \
"s/^version[[:space:]]*=[[:space:]]*\"[^\"]+\"/version = \"$new_version\"/" \
"$CARGO_FILE"


echo "Версии обновлены:"
echo ""

grep '"version"' "$TAURI_CONFIG"
grep '^version' "$CARGO_FILE"


echo ""


# Подтверждение
read -p "Создать релиз v$new_version? (y/n): " confirm


if [ "$confirm" != "y" ]; then
    echo "Отмена"
    exit 0
fi


# Git commit
git add "$TAURI_CONFIG" "$CARGO_FILE"

git commit -m "Release v$new_version"


# Создаем тег
git tag -a "v$new_version" \
    -m "Release v$new_version"


# Отправляем
git push origin main

git push origin "v$new_version"


echo ""
echo "=============================="
echo "Релиз v$new_version отправлен"
echo "GitHub Actions начал сборку"
echo "=============================="
